/* Design tokens from original */
:root {
  --font-heading: 'Playfair Display', Georgia, serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  /* === COLORS NEUTRAS === */
  --color-bg: #FAFAF8;
  --color-surface: #FFFFFF;
  --color-text: #1C1917;
  --color-muted: #78716C;
  --color-border: rgba(28, 25, 23, 0.08);

  /* === SPACING === */
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;
  --space-3xl: 64px;

  /* === BORDER RADIUS === */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;

  /* === SHADOWS === */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 16px 40px rgba(0, 0, 0, 0.10);

  /* === CONTAINER === */
  --container: 1200px;
  --content-max: 720px;
}

/* === ETAPA 1 — Trilha de Novos (amarelo) === */
[data-etapa="1"] {
  --accent: #EAB308;
  --accent-soft: #FEF3C7;
  --accent-border: rgba(234, 179, 8, 0.15);
  --accent-hover: rgba(234, 179, 8, 0.08);
  --accent-text: #92400E;
  --accent-on-accent: #422006;
  --accent-gradient: linear-gradient(135deg, #EAB308, #854D0E);
}

/* Tailwind directives */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom theme using @theme (Tailwind v3+)*/
@theme {
  --font-sans: var(--font-body);
  --font-heading: var(--font-heading);

  /* Neutrals */
  --color-bg: var(--color-bg);
  --color-surface: var(--color-surface);
  --color-text: var(--color-text);
  --color-muted: var(--color-muted);
  --color-border: var(--color-border);

  /* Accent (etapa 1 amarelo) */
  --color-accent: var(--accent);
  --color-accent-soft: var(--accent-soft);
  --color-accent-border: var(--accent-border);
  --color-accent-hover: var(--accent-hover);
  --color-accent-text: var(--accent-text);
  --color-accent-on-accent: var(--accent-on-accent);

  /* Spacing */
  --space-xs: var(--space-xs);
  --space-sm: var(--space-sm);
  --space-md: var(--space-md);
  --space-lg: var(--space-lg);
  --space-xl: var(--space-xl);
  --space-2xl: var(--space-2xl);
  --space-3xl: var(--space-3xl);

  /* Radius */
  --radius-sm: var(--radius-sm);
  --radius-md: var(--radius-md);
  --radius-lg: var(--radius-lg);
  --radius-xl: var(--radius-xl);
  --radius-full: var(--radius-full);

  /* Shadows */
  --shadow-sm: var(--shadow-sm);
  --shadow-md: var(--shadow-md);
  --shadow-lg: var(--shadow-lg);
  --shadow-xl: var(--shadow-xl);
}

@layer utilities {
  .bg-bg { background-color: var(--color-bg); }
  .bg-surface { background-color: var(--color-surface); }
  .text-text { color: var(--color-text); }
  .text-muted { color: var(--color-muted); }
  .border-border { border-color: var(--color-border); }
  .bg-accent { background-color: var(--color-accent); }
  .text-accent { color: var(--color-accent); }
  .hover\:bg-accent\/10:hover { background-color: hsl(var(--color-accent) / 0.1); } /* placeholder */
}

@custom-variant dark (&:where(.dark, .dark *));

body {
  @apply bg-bg text-text antialiased;
}
